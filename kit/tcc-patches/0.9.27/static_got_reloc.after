#if defined(TCC_TARGET_I386) || defined(TCC_MUSL)
        if (s->reloc && s != s1->got && (s->sh_flags & SHF_ALLOC)) //gr
        /* On X86 gdb 7.3 works in any case but gdb 6.6 will crash if SHF_ALLOC
        checking is removed */
#else
#ifdef TCC_TARGET_X86_64
        /* The entries of the GOT are filled by the dynamic loader; a statically
           linked executable has none, so relocate the GOT as well. */
        if (s->reloc && (s != s1->got || !s1->dynsym))
#else
        if (s->reloc && s != s1->got)
#endif
        /* On X86_64 gdb 7.3 will crash if SHF_ALLOC checking is present */
#endif
            relocate_section(s1, s);
    }
