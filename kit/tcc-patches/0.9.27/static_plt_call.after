            if (gotplt_entry == NO_GOTPLT_ENTRY) {
                continue;
            }

#ifdef TCC_TARGET_X86_64
            /* A statically linked executable has no dynamic linker, so the GOT
               entry a PLT stub jumps through would never be filled. */
            if (s1->static_link) {
                /* Calls go directly to the symbol: it is in the executable. */
                if (type == R_X86_64_PLT32 || type == R_X86_64_PC32) {
                    rel->r_info = ELFW(R_INFO)(sym_index, R_X86_64_PC32);
                    continue;
                }
                /* A reference through the GOT gets an entry for the symbol
                   itself (without a PLT stub) whose address is written when the
                   output is relocated; the code below would allocate the entry
                   of a PLT stub instead, which nothing would ever fill. */
                if (type == R_X86_64_GOTPCREL || type == R_X86_64_GOTPCRELX
                    || type == R_X86_64_REX_GOTPCRELX) {
                    if (!s1->got)
                        build_got(s1);
                    put_got_entry(s1, R_GLOB_DAT, sym->st_size, sym->st_info,
                                  sym_index);
                    continue;
                }
                /* Everything else (plain data references) needs no entry. */
                if (sym->st_shndx != SHN_UNDEF && sym->st_shndx != SHN_XINDEX)
                    continue;
            }
#endif

